# Generated build state — the sidecar binaries are products, not sources.
.sea/
.cache/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
# Generated sidecar payloads (build-materialized); the README placeholders
# stay committed — and their parent dirs must be re-included for that to work.
src-tauri/sidecar-resources/*
!src-tauri/sidecar-resources/README.md
!src-tauri/sidecar-resources/web
src-tauri/sidecar-resources/web/*
!src-tauri/sidecar-resources/web/README.md
!src-tauri/sidecar-resources/web/assets
src-tauri/sidecar-resources/web/assets/*
!src-tauri/sidecar-resources/web/assets/README.md
src-tauri/target/
src-tauri/gen/
