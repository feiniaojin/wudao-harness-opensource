{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "悟道Harness",
  "version": "0.5.2",
  "identifier": "com.feiniaojin.wudao-harness-desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "悟道Harness",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active",
          "radius": 0
        },
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 14
        }
      },
      {
        "label": "pet",
        "title": "wudao pet",
        "url": "pet.html",
        "width": 220,
        "height": 320,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/wudao-server"
    ],
    "resources": [
      "sidecar-resources/*",
      "sidecar-resources/web/*",
      "sidecar-resources/web/assets/*",
      "sidecar-resources/web/pet/*",
      "sidecar-resources/node_modules/playwright-core/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
