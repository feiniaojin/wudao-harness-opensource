{
  "name": "@wudao-org/server",
  "version": "0.5.8",
  "type": "module",
  "description": "Localhost WS server for the wudao agent driver — first-frame auth, two-channel state protocol (see PROTOCOL.md).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/publish-assets.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "feiniaojin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiniaojin/wudao-harness.git"
  },
  "keywords": [
    "agent",
    "harness",
    "websocket",
    "protocol",
    "llm"
  ]
}
