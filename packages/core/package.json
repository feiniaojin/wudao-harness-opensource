{
  "name": "@wudao-org/core",
  "version": "0.5.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trace": {
      "types": "./dist/trace/index.d.ts",
      "import": "./dist/trace/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsc -p tsconfig.json && node examples/read-file-demo.mjs",
    "prepublishOnly": "node ../../scripts/publish-assets.mjs"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "description": "Core runtime for wudao-harness: agent loop, tools, sessions, compaction, hooks.",
  "license": "MIT",
  "author": "feiniaojin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiniaojin/wudao-harness.git"
  },
  "dependencies": {
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "fetch-socks": "^1.3.3",
    "socks": "^2.8.7"
  }
}
